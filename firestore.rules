rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function previewUrlOk(data) {
      return !data.keys().hasAny(['preview_image_url'])
        || data.preview_image_url == ''
        || (data.preview_image_url is string
            && data.preview_image_url.matches('^https://[^\\s]+$'));
    }

    // userId is the Firebase Auth uid. request.auth.uid must match that path.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['isAdmin', 'premium', 'credits']);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isAdmin', 'premium', 'credits']);
      allow delete: if false;

      match /payments/{paymentId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /profile/{profileId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.credits == 1000
          && !request.resource.data.keys().hasAny(['isAdmin', 'premium']);
        allow update: if isOwner(userId)
          && request.resource.data.credits == resource.data.credits
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isAdmin', 'premium']);
        allow delete: if false;
      }

      match /talkingPhotos/{photoId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && previewUrlOk(request.resource.data);
        allow delete: if isOwner(userId);

        match /videos/{videoId} {
          allow read: if isOwner(userId);
          allow write: if false;
        }
      }
    }
  }
}
